<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 以下与 FCL 相同 -->
    <!-- 写入游戏的 DNS 配置时读取当前网络 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 下载时保持 CPU 与 WiFi 活跃，关屏或切到后台时下载不中断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 按键与手柄的震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 陀螺仪超过 200Hz 的采样率 -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- 游戏内使用麦克风（如语音聊天 Mod），在设置中由玩家授权 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:glEsVersion="0x00020000" />
    <!-- 游戏运行时的保活前台服务（与 FCL 的 GameService 相同） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- JVM 会使用指针的高位，关闭 Android 11+ 的堆指针标记，否则 JVM 启动即被系统终止（与 FCL 相同）。 -->
    <!-- 与 FCL 相同声明为游戏：系统的游戏模式与手机厂商的游戏加速按它识别游戏，否则按普通应用调度 -->
    <application
        android:appCategory="game"
        android:isGame="true"
        android:allowNativeHeapPointerTagging="false"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.red_craft"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameActivity"
            android:process=":jvm"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.FoldCraftLauncher" />
        <service
            android:name=".JavaService"
            android:process=":jvm"
            android:exported="false" />
        <service
            android:name="com.mio.service.GameService"
            android:process=":jvm"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep game process alive while a Minecraft session is running" />
        </service>
        <!-- 与 FCL 相同：声明支持系统的游戏模式（Android 13） -->
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />
        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
